# Copy to .env.local and fill in values.
# Never commit real secrets.

# Local Docker Postgres (see docker-compose.yml)
DATABASE_URL=postgresql://frannys:frannys@localhost:5433/frannys

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true

# Set true only behind a reverse proxy that sets X-Forwarded-For / X-Real-IP.
# On Vercel this is automatic. Leaving false ignores spoofable client IP headers.
# TRUST_PROXY=true

# First admin account (used by seed)
ADMIN_EMAIL=admin@frannys.com
ADMIN_PASSWORD=changeme123

# Absolute site URL (SEO, sitemap, Open Graph). Required in production.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional Auth.js production URL (set if AUTH_URL differs from public site)
# AUTH_URL=https://your-domain.com

# Contact form email (SMTP). Without these, the form opens the visitor's mail app.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Frannys Tidy Solutions <hello@example.com>"
# CONTACT_TO_EMAIL=frannystidysolutions@gmail.com
