# Copy to .env.local and fill in values.
# Never commit real secrets.

# Postgres connection string (required).
# Local Docker: docker compose up -d postgres  (see docker-compose.yml)
DATABASE_URL=postgresql://frannys:frannys@localhost:5433/frannys
# Or Neon cloud (no Docker). See docs/NEON_SETUP.md
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true

# Set true only behind a reverse proxy that sets X-Forwarded-For / X-Real-IP.
# On Vercel this is automatic. Leaving false ignores spoofable client IP headers.
# TRUST_PROXY=true

# First admin account (used by seed)
ADMIN_EMAIL=admin@frannys.com
ADMIN_PASSWORD=changeme123

# Absolute site URL (SEO, sitemap, Open Graph, canonical host redirects). Required in production.
# Use one primary host only. Example: https://frannystidysolutions.com
# NEXT_PUBLIC_SITE_URL=https://frannystidysolutions.com

# Optional: Neon Object Storage for admin image uploads (Vercel needs this).
# In Neon Console → Connect → Storage → copy the .env tab, then set the bucket name.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH.storage.c-4.us-east-2.aws.neon.tech
# AWS_REGION=us-east-2
# STORAGE_S3_BUCKET=assets
# Bucket must be public_read. Public URL defaults to {AWS_ENDPOINT_URL_S3}/{STORAGE_S3_BUCKET}.

# Optional Auth.js production URL (set if AUTH_URL differs from public site)
# AUTH_URL=https://your-domain.com

# Contact form email (SMTP). Without these, the form opens the visitor's mail app.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Frannys Tidy Solutions <hello@example.com>"
# CONTACT_TO_EMAIL=frannystidysolutions@gmail.com
